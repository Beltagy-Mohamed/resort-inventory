# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file — it's already in .gitignore.

# --- Core ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_SITE_URL=https://yourdomain.com
DJANGO_TIME_ZONE=Africa/Cairo

# --- Database ---
# Leave DJANGO_DB_ENGINE unset (or remove the line) to keep using SQLite.
# Set it to "postgres" for production once more than one person uses
# the system concurrently — SQLite does not handle concurrent writers well.
DJANGO_DB_ENGINE=postgres
DJANGO_DB_NAME=inventory_db
DJANGO_DB_USER=inventory_user
DJANGO_DB_PASSWORD=change-this-password
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# --- HTTPS (only used when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
