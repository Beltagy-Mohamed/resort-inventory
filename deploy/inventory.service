# systemd unit — copy to /etc/systemd/system/inventory.service
# then: systemctl daemon-reload && systemctl enable --now inventory

[Unit]
Description=Inventory System (Gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/inventory
EnvironmentFile=/var/www/inventory/.env
ExecStart=/var/www/inventory/.venv/bin/gunicorn -c deploy/gunicorn.conf.py config.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
